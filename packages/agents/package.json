{
  "name": "umbra-agents",
  "version": "0.1.1",
  "description": "Agent tools for umbra-engine: Playtester, Builder, Fixer, route and balance search, and an MCP server.",
  "keywords": [
    "ai-agents",
    "playtesting",
    "mcp",
    "game-testing",
    "umbra-engine"
  ],
  "license": "MIT",
  "author": "Minh Pham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhpham1810/umbra.git"
  },
  "homepage": "https://github.com/minhpham1810/umbra#readme",
  "bugs": "https://github.com/minhpham1810/umbra/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "umbra-mcp": "./dist/mcp-stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mcp-stdio.ts --format esm --dts",
    "dev": "tsup src/index.ts src/mcp-stdio.ts --format esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp-stdio.ts",
    "playtest": "tsx src/playtest-cli.ts",
    "haunt": "tsx src/haunt-cli.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@google/genai": "2.29.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "umbra-engine": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "tsx": "4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
