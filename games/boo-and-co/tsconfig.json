{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@umbra/engine": [
        "../../packages/engine/src/index.ts"
      ],
      "@umbra/agents": [
        "../../packages/agents/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
